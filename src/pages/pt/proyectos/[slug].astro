---
import Layout from "@layouts/Layout.astro";
import ProjectDetailBody from "@components/pages/ProjectDetailBody.astro";
import { projects } from "@/data/projects";
import { site } from "@/lib/site";
import { useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const t = useTranslations("pt");
const copy = t.projects.items[project.id];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t.caseStudy.breadcrumbHome, item: `${site.url}/pt` },
    { "@type": "ListItem", position: 2, name: t.caseStudy.breadcrumbProjects, item: `${site.url}/pt#proyectos` },
    { "@type": "ListItem", position: 3, name: copy.name, item: `${site.url}/pt/proyectos/${project.slug}` },
  ],
};
---

<Layout
  title={copy.name}
  description={copy.description}
  path={`/proyectos/${project.slug}`}
  lang="pt"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  <ProjectDetailBody project={project} lang="pt" />
</Layout>
