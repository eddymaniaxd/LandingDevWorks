---
import Layout from "@layouts/Layout.astro";
import ContactBody from "@components/pages/ContactBody.astro";
import { useTranslations } from "@/i18n/utils";

// SSR: ver nota en src/pages/index.astro sobre por qué esta ruta necesita
// `prerender = false` para que el middleware de detección de idioma corra.
export const prerender = false;

const t = useTranslations("es");
---

<Layout
  title={t.meta.contact.title}
  description={t.meta.contact.description}
  path="/contacto"
  lang="es"
>
  <ContactBody lang="es" />
</Layout>
