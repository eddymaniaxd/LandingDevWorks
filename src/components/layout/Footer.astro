---
import Icon from "@components/shared/Icon.astro";
import { site, getNavItems, getWhatsAppHref } from "@/lib/site";
import { defaultLocale, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const columns = [
  {
    title: t.footer.navTitle,
    links: getNavItems(lang, t),
  },
];
---

<footer class="border-t border-border bg-background-elevated">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div>
      <span class="font-display text-sm font-bold tracking-[0.18em] text-foreground">
        DEV<span class="text-accent">WORKS</span>
      </span>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-foreground-muted">
        {t.footer.tagline}
      </p>
    </div>

    {columns.map((col) => (
      <div>
        <h3 class="text-sm font-medium text-foreground">{col.title}</h3>
        <ul class="mt-4 space-y-3">
          {col.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-foreground-muted transition-colors hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div>
      <h3 class="text-sm font-medium text-foreground">{t.footer.contactTitle}</h3>
      <ul class="mt-4 space-y-3">
        {site.whatsapp.isConfigured && (
          <li>
            <a
              href={getWhatsAppHref(lang, t)}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics="whatsapp_click"
              class="inline-flex items-center gap-2 text-sm text-foreground-muted transition-colors hover:text-foreground"
            >
              <Icon name="message-circle" size={16} /> WhatsApp
            </a>
          </li>
        )}
        <li>
          <a href={`mailto:${site.contactEmail}`} class="inline-flex items-center gap-2 text-sm text-foreground-muted transition-colors hover:text-foreground">
            <Icon name="mail" size={16} /> {site.contactEmail}
          </a>
        </li>
        <li>
          <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-foreground-muted transition-colors hover:text-foreground">
            <Icon name="linkedin" size={16} /> LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-page flex items-center justify-center py-6 text-xs text-muted">
      <p>© {year} Dev Works. {t.footer.rights}</p>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-analytics="whatsapp_click"]').forEach((el) => {
    el.addEventListener("click", () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "whatsapp_click", source: "footer" });
      window.gtag?.("event", "whatsapp_click", { source: "footer" });
    });
  });
</script>
