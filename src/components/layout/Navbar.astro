---
import { getNavItems } from "@/lib/site";
import { defaultLocale, type Locale } from "@/i18n/config";
import { useTranslations, localizedPath } from "@/i18n/utils";
import MobileMenu from "@components/layout/MobileMenu";
import LanguageSwitcher from "@components/layout/LanguageSwitcher";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const navItems = getNavItems(lang, t);
const contactHref = localizedPath("/contacto", lang);
const homeHref = localizedPath("/", lang);
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300">
  <nav class="container-page flex h-16 items-center justify-between md:h-20" aria-label="Navegación principal">
    <a href={homeHref} class="font-display text-sm font-bold tracking-[0.18em] text-foreground md:text-base">
      DEV<span class="text-accent">WORKS</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm text-foreground-muted transition-colors hover:text-foreground"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-4 md:flex">
      <LanguageSwitcher client:load currentLocale={lang} />
      <a
        href={contactHref}
        data-analytics="nav_cta_click"
        class="group inline-flex items-center gap-2 rounded-pill border border-border-strong bg-surface px-5 py-2.5 text-sm font-medium text-foreground transition-all hover:border-accent/50 hover:bg-surface-hover"
      >
        {t.nav.hablemos}
        <span class="transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>
    </div>

    <MobileMenu client:load navItems={[...navItems]} contactHref={contactHref} lang={lang} />
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");

  function updateHeaderState() {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add("glass", "border-border");
      header.classList.remove("border-transparent");
    } else {
      header.classList.remove("glass", "border-border");
      header.classList.add("border-transparent");
    }
  }

  updateHeaderState();
  window.addEventListener("scroll", updateHeaderState, { passive: true });

  // Analytics: nav CTA clicks
  document.querySelectorAll('[data-analytics="nav_cta_click"]').forEach((el) => {
    el.addEventListener("click", () => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "nav_cta_click" });
      window.gtag?.("event", "nav_cta_click");
    });
  });
</script>
