---
import Icon from "@components/shared/Icon.astro";
import type { CollectionEntry } from "astro:content";
import { defaultLocale, localeHtmlLang, type Locale } from "@/i18n/config";
import { useTranslations, localizedPath } from "@/i18n/utils";
import { estimateReadingMinutes, formatPostDate } from "@/lib/utils";

interface Props {
  entry: CollectionEntry<"blog">;
  postSlug: string;
  index: number;
  lang?: Locale;
}

const { entry, postSlug, index, lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const gradients = [
  "from-accent/25 via-transparent to-transparent",
  "from-accent-2/20 via-transparent to-transparent",
  "from-accent/15 via-accent-2/10 to-transparent",
];

const minutes = estimateReadingMinutes(entry.body);
const dateLabel = formatPostDate(entry.data.publishDate, localeHtmlLang[lang]);
const href = localizedPath(`/blog/${postSlug}`, lang);
---

<article class="blog-card group flex flex-col overflow-hidden rounded-lg border border-border bg-surface transition-colors duration-300 hover:border-accent/40">
  <a href={href} class={`relative flex aspect-[16/8] items-center justify-center overflow-hidden bg-gradient-to-br ${gradients[index % gradients.length]} bg-background-elevated`}>
    {entry.data.coverImage ? (
      <img
        src={entry.data.coverImage}
        alt=""
        loading="lazy"
        decoding="async"
        style={entry.data.coverImagePosition ? `object-position: ${entry.data.coverImagePosition}` : undefined}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <>
        <div class="bg-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
        <Icon name="pen-line" size={48} strokeWidth={1} class="text-foreground/10 transition-transform duration-500 group-hover:scale-110" />
      </>
    )}
    <span class="absolute left-4 top-4 rounded-pill border border-border bg-background/70 px-3 py-1 text-[11px] font-medium tracking-wide text-foreground-muted backdrop-blur-sm">
      {entry.data.category}
    </span>
  </a>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-4 text-xs text-muted">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={13} />
        {dateLabel}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="clock" size={13} />
        {minutes} {t.blog.minReadSuffix}
      </span>
    </div>

    <h3 class="mt-3 font-display text-lg font-semibold text-foreground md:text-xl">
      <a href={href} class="transition-colors hover:text-accent">{entry.data.title}</a>
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-foreground-muted">{entry.data.description}</p>

    <a
      href={href}
      data-analytics="blog_post_view"
      data-post={postSlug}
      class="group/link mt-6 inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-accent"
    >
      {t.blog.readMore}
      <span class="transition-transform duration-300 group-hover/link:translate-x-1" aria-hidden="true">→</span>
    </a>
  </div>
</article>
