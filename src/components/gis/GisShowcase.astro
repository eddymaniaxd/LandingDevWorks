---
import Icon from "@components/shared/Icon.astro";
import { defaultLocale, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const markers = [
  { x: 22, y: 28 },
  { x: 38, y: 18 },
  { x: 58, y: 24 },
  { x: 70, y: 42 },
  { x: 30, y: 55 },
  { x: 48, y: 62 },
  { x: 80, y: 60 },
  { x: 18, y: 72 },
];

const activeMarker = { x: 58, y: 24 };
---

<section id="gis" class="relative overflow-hidden border-y border-border bg-background-elevated py-24 md:py-32" aria-labelledby="gis-heading">
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <p data-reveal class="mb-4 text-sm font-medium tracking-[0.14em] text-accent-2">{t.gis.eyebrow}</p>
      <h2 id="gis-heading" data-reveal data-reveal-delay="60" class="font-display text-h2 font-semibold text-foreground text-balance">
        {t.gis.heading}
      </h2>
      <p data-reveal data-reveal-delay="120" class="mt-5 text-body-lg leading-relaxed text-foreground-muted">
        {t.gis.description}
      </p>

      <ul data-reveal data-reveal-delay="180" class="mt-8 space-y-3">
        {t.gis.features.map((item) => (
          <li class="flex items-center gap-3 text-sm text-foreground-muted">
            <Icon name="check" size={16} class="text-accent-2" />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal data-reveal-delay="120" class="relative">
      <p class="mb-3 text-center text-xs tracking-wide text-muted lg:text-left">{t.gis.previewLabel}</p>

      <div class="glass relative aspect-[4/3] w-full overflow-hidden rounded-lg shadow-soft">
        <!-- Base del mapa: grid técnico + "calles" -->
        <div class="absolute inset-0 bg-[#0d0d12]"></div>
        <svg class="absolute inset-0 h-full w-full opacity-50" viewBox="0 0 100 75" preserveAspectRatio="none">
          <g stroke="rgba(255,255,255,0.12)" stroke-width="0.4">
            <line x1="0" y1="20" x2="100" y2="15" />
            <line x1="0" y1="45" x2="100" y2="50" />
            <line x1="15" y1="0" x2="10" y2="75" />
            <line x1="55" y1="0" x2="60" y2="75" />
          </g>
        </svg>

        <!-- Lotes (polígonos sutiles) -->
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 75" preserveAspectRatio="none">
          <g fill="rgba(110,107,255,0.08)" stroke="rgba(110,107,255,0.35)" stroke-width="0.3">
            <polygon points="20,10 34,8 36,20 22,22" />
            <polygon points="40,8 54,10 52,22 38,20" />
            <polygon points="20,25 34,25 34,40 20,40" />
            <polygon points="60,30 76,28 78,44 62,46" />
          </g>
        </svg>

        <!-- Marcadores -->
        {markers.map((m) => (
          <span
            class="absolute h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-2/80"
            style={`left:${m.x}%; top:${m.y}%;`}
          ></span>
        ))}

        <!-- Marcador activo -->
        <span
          class="absolute flex h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent shadow-glow"
          style={`left:${activeMarker.x}%; top:${activeMarker.y}%;`}
        >
          <span class="h-full w-full animate-pulse-slow rounded-full bg-accent"></span>
        </span>

        <!-- Popup de información del lote -->
        <div
          class="glass absolute w-40 rounded-md p-3 text-left shadow-soft sm:w-48"
          style={`left:${activeMarker.x}%; top:${activeMarker.y}%; transform: translate(12px, -110%);`}
        >
          <p class="text-xs font-semibold text-foreground">{t.gis.popup.title}</p>
          <div class="mt-2 space-y-1 text-[11px] text-foreground-muted">
            <p>{t.gis.popup.area}</p>
            <p class="inline-flex items-center gap-1 text-accent-2">
              <span class="h-1.5 w-1.5 rounded-full bg-accent-2"></span> {t.gis.popup.available}
            </p>
          </div>
          <p class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-accent">
            {t.gis.popup.viewInfo}
            <span aria-hidden="true">→</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
