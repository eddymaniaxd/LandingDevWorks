---
import HeroVisual from "@components/hero/HeroVisual";
import { defaultLocale, type Locale } from "@/i18n/config";
import { useTranslations, localizedPath } from "@/i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const projectsHref = `${localizedPath("/", lang)}#proyectos`;
---

<section class="relative flex min-h-[92vh] items-center overflow-hidden pt-28 md:min-h-[95vh] md:pt-32">
  <!-- Technical grid + glow backdrop -->
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] -z-10 h-[560px] w-[560px] rounded-full opacity-40 blur-[120px]"
    style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
    <div>
      <p
        class="animate-fade-up mb-6 inline-flex items-center gap-2 rounded-pill border border-border bg-surface/60 px-4 py-1.5 text-xs font-medium tracking-wide text-foreground-muted"
        style="animation-delay: 0ms"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent-2"></span>
        {t.hero.badge}
      </p>

      <h1
        class="animate-fade-up text-gradient font-display text-h1 font-semibold text-balance"
        style="animation-delay: 80ms"
      >
        {t.hero.title}
      </h1>

      <p
        class="animate-fade-up mt-6 max-w-xl text-body-lg leading-relaxed text-foreground-muted"
        style="animation-delay: 180ms"
      >
        {t.hero.description}
      </p>

      <div class="animate-fade-up mt-10 flex flex-col gap-4 sm:flex-row sm:items-center" style="animation-delay: 260ms">
        <a
          href={localizedPath("/contacto", lang)}
          data-analytics="hero_cta_click"
          class="group inline-flex items-center justify-center gap-2 rounded-pill bg-accent px-7 py-3.5 text-sm font-medium text-white shadow-soft transition-all hover:bg-accent-hover"
        >
          {t.hero.ctaPrimary}
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <a
          href={projectsHref}
          data-analytics="hero_secondary_cta_click"
          class="inline-flex items-center justify-center gap-2 rounded-pill border border-border-strong px-7 py-3.5 text-sm font-medium text-foreground transition-colors hover:border-accent/50 hover:bg-surface"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="animate-fade-in relative" style="animation-delay: 320ms">
      <HeroVisual client:idle lang={lang} />
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-background to-transparent" aria-hidden="true"></div>
</section>

<script>
  document.querySelectorAll('[data-analytics="hero_cta_click"], [data-analytics="hero_secondary_cta_click"]').forEach((el) => {
    el.addEventListener("click", (e) => {
      const eventName = (e.currentTarget as HTMLElement).getAttribute("data-analytics");
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: eventName });
      window.gtag?.("event", eventName);
    });
  });
</script>
