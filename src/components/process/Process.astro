---
import { processSteps } from "@/data/process";
import { defaultLocale, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-24 md:py-32" aria-labelledby="process-heading">
  <div class="container-page">
    <div class="max-w-2xl">
      <p data-reveal class="mb-4 text-sm font-medium tracking-[0.14em] text-accent">{t.process.eyebrow}</p>
      <h2 id="process-heading" data-reveal data-reveal-delay="60" class="font-display text-h2 font-semibold text-foreground">
        {t.process.heading}
      </h2>
    </div>

    <div id="process-track" class="relative mt-16 md:mt-20 md:pl-4">
      <!-- Línea base + línea de progreso (animada con ScrollTrigger) -->
      <div class="absolute left-0 top-0 h-full w-px bg-border md:left-4" aria-hidden="true"></div>
      <div id="process-line-fill" class="absolute left-0 top-0 w-px origin-top scale-y-0 bg-accent md:left-4" style="height: 100%;" aria-hidden="true"></div>

      <ol class="space-y-14 md:space-y-20">
        {processSteps.map((step) => {
          const copy = t.process.steps[step.id];
          return (
            <li class="process-step relative pl-10 md:pl-16" data-process-step>
              <span class="absolute left-0 top-0 flex h-8 w-8 -translate-x-1/2 items-center justify-center rounded-full border border-border-strong bg-background font-mono text-xs text-foreground-muted transition-colors duration-500 md:left-4 process-step-dot">
                {step.number}
              </span>
              <h3 class="font-display text-2xl font-semibold text-foreground md:text-3xl">{copy.title}</h3>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-foreground-muted md:text-base">{copy.description}</p>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<script>
  import { getGsap } from "@/lib/gsap-client";

  function initProcessTimeline() {
    const track = document.getElementById("process-track");
    const fill = document.getElementById("process-line-fill");
    if (!track || !fill) return;

    const { gsap, ScrollTrigger } = getGsap();

    gsap.to(fill, {
      scaleY: 1,
      ease: "none",
      scrollTrigger: {
        trigger: track,
        start: "top 70%",
        end: "bottom 60%",
        scrub: 0.4,
      },
    });

    document.querySelectorAll<HTMLElement>("[data-process-step]").forEach((step) => {
      const dot = step.querySelector<HTMLElement>(".process-step-dot");
      ScrollTrigger.create({
        trigger: step,
        start: "top 65%",
        onEnter: () => dot?.classList.add("border-accent", "text-accent"),
        onLeaveBack: () => dot?.classList.remove("border-accent", "text-accent"),
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProcessTimeline);
  } else {
    initProcessTimeline();
  }
</script>
