# Copia este archivo como .env y completa con los datos reales de Dev Works.

# WhatsApp (formato internacional sin signos, ej: 59171234567)
PUBLIC_WHATSAPP_NUMBER=59100000000
PUBLIC_WHATSAPP_MESSAGE="Hola Dev Works, me gustaría cotizar un proyecto"

# Contacto
PUBLIC_CONTACT_EMAIL=hola@devworks.com

# Redes
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/devworks

# Opcional: link para agendar llamadas (Calendly, Cal.com...). Si está vacío,
# los botones "Agendar" no aparecen y los CTA llevan al formulario de contacto.
PUBLIC_BOOKING_URL=

# Opcional: URL de embed del video de presentación de 60 s (Loom, YouTube,
# Vimeo) para la página /team. Ej: https://www.loom.com/embed/XXXX
PUBLIC_INTRO_VIDEO_URL=

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend del formulario de contacto (server-side only, no PUBLIC_)
# Opción A (recomendada): envío por Gmail. La cuenta necesita verificación en 2
# pasos activada, y una "contraseña de aplicación" generada en
# https://myaccount.google.com/apppasswords (NO es la contraseña normal de Gmail).
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL_TO=

# Opción B (opcional, además de o en vez de Gmail): reenviar a un webhook
# (Slack, Zapier, un CRM, etc.)
CONTACT_FORM_WEBHOOK_URL=

CONTACT_FORM_RATE_LIMIT_MAX=5
CONTACT_FORM_RATE_LIMIT_WINDOW_MS=60000
